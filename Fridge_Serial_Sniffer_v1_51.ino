// WEB HANDLERS
// --------------------------------------------------------------------------------
void handleRoot() {
  server.sendHeader("Cache-Control", "no-store");   // always serve the page from this firmware
  server.sendHeader("Content-Encoding", "gzip");       // the page is stored gzip-compressed
  server.send_P(200, "text/html; charset=utf-8", (PGM_P)PAGE_GZ, PAGE_GZ_LEN);
}

void handleData() {
  static const char HEXCH[] = "0123456789ABCDEF";
  bool wantFrames = server.hasArg("since");          // only the Diagnostics page asks for frames
  uint32_t since = wantFrames ? strtoul(server.arg("since").c_str(), nullptr, 10) : 0;
  uint32_t start = since + 1;
  if (start < firstSeq) start = firstSeq;
  if (nextSeq > LOG_FRAMES && start < nextSeq - LOG_FRAMES) start = nextSeq - LOG_FRAMES;

  String out;
  out.reserve(1536 + (wantFrames && nextSeq > start ? (nextSeq - start) * (FRAME_MAX * 2 + 40) : 0));
  out += "{\"epoch\":" + String(epoch);
  out += ",\"ver\":\"" FW_VERSION "\"";
  out += ",\"baud\":" + String(cfgBaud);
  out += ",\"fmt\":" + String(cfgFmt);
  out += ",\"inv\":" + String(cfgInvert ? 1 : 0);
  out += ",\"gap\":" + String(cfgGapMs);
  out += ",\"pin\":" + String(RX_PIN);
  out += ",\"bytes\":" + String(totalBytes);
  out += ",\"fe\":" + String((uint32_t)errFrame);
  out += ",\"pe\":" + String((uint32_t)errParity);
  out += ",\"ovf\":" + String((uint32_t)errOverflow);
  out += ",\"rst\":" + String(uartRestarts);
  out += ",\"ln\":{\"e\":" + (anyEdge ? String(millis() - lastLineEdgeMs) : String(-1));
  out += ",\"b\":" + (anyByte ? String(millis() - lastByteMs) : String(-1));
  out += ",\"lv\":" + String(lineLevel);
  out += ",\"fix\":" + String(portFixes) + "}";
  out += ",\"rr\":\"" + String(resetReasonText()) + "\"";
  out += ",\"rssi\":" + String(WiFi.RSSI());
  out += ",\"ssid\":\"" + jsonEsc(WiFi.SSID().c_str()) + "\"";
  out += ",\"ip\":\"" + WiFi.localIP().toString() + "\"";
  out += ",\"up\":" + String(uptimeSec());
  out += ",\"ka\":{\"en\":" + String(cfgKaEn ? 1 : 0) + ",\"sec\":" + String(cfgKaSec) +
         ",\"n\":" + String(kaSent) +
         ",\"ago\":" + (kaLastSent ? String(millis() - kaLastSent) : String(-1)) +
         ",\"ans\":" + (lastAnswerMs ? String(millis() - lastAnswerMs) : String(-1)) + "}";
  out += ",\"cal\":{\"of\":" + String(offFridge, 1) + ",\"oz\":" + String(offFreezer, 1) + "}";
  out += ",\"dec\":{\"m\":\"" + msgHex() + "\"";
  out += ",\"air\":" + (isnan(airTemp) ? String("null") : String(airTemp, 1));
  out += ",\"fz\":" + (isnan(frzTemp) ? String("null") : String(frzTemp, 1));
  out += ",\"ft\":" + (haveFridgeTemp ? String(fridgeTemp) : String("null"));
  out += ",\"zt\":" + (haveFreezerTemp ? String(freezerTemp) : String("null"));
  out += ",\"age\":" + String(haveMsg ? (millis() - lastMsgMs) : 0);
  out += ",\"bad\":" + String(badCount);
  out += ",\"st\":" + String(dataIsStale() ? 1 : 0) + "}";
  out += ",\"ice\":{\"n24\":" + String(iceFills24h()) + ",\"tot\":" + String(iceFillTotal) +
         ",\"ago\":" + (iceFillLastMs ? String(millis() - iceFillLastMs) :
                       (iceFillLastEp && clockValid() ? String((epochNow() - iceFillLastEp) * 1000UL) : String(-1))) +
         ",\"ep\":" + String(iceFillLastEp) + ",\"full\":" + String(iceFull ? 1 : 0) + ",\"fs\":" + String(cfgIceFullSec) + "}";
  out += ",\"chg\":{\"n\":" + String(chgSeq) + ",\"l\":[";
  {
    uint32_t cnt = chgSeq < CHG_N ? chgSeq : CHG_N;
    for (uint32_t k = 0; k < cnt; k++) {           // newest first
      const ChangeRec& c = chgLog[(chgSeq - 1 - k) % CHG_N];
      if (k) out += ',';
      out += "[" + String(millis() - c.ms) + "," + String(c.ep) + ",\"" + jsonEsc(c.txt) + "\"]";
    }
  }
  out += "]}";
  out += ",\"mq\":{\"on\":" + String(mqttClient.connected() ? 1 : 0);
  out += ",\"host\":\"" + jsonEsc(mqtt_server) + "\"";
  out += ",\"port\":" + String(mqtt_port);
  out += ",\"user\":\"" + jsonEsc(mqtt_user) + "\"";
  out += ",\"topic\":\"" + jsonEsc(mqtt_topic) + "\"";
  out += ",\"stale\":" + String(cfgStaleMin) + "}";
  if (wantFrames) {                                  // Diagnostics page: undecoded bytes and bits
    out += ",\"unk\":{\"i\":[";
    for (uint8_t k = 0; k < UNK_N; k++) {
      String label, val;
      if (k < UNK_NBYTES) {
        label = "Byte " + String(UNK_BYTES[k]);
        val = haveMsg ? hx2(lastMsg[UNK_BYTES[k]]) : String("-");
      } else if (k == UNK_NBYTES) {
        label = "Bytes " + String(UNK_FIRST) + "-" + String(UNK_LAST);
        if (haveMsg) for (uint8_t i = UNK_FIRST; i <= UNK_LAST; i++) {
          char h[4]; snprintf(h, sizeof h, i > UNK_FIRST ? " %02X" : "%02X", lastMsg[i]); val += h;
        } else val = "-";
      } else {
        const UnkBit& u = UNK_BITS[k - UNK_NBYTES - 1];
        label = "Byte " + String(u.i) + " bit " + hx2(u.mask);
        val = haveMsg ? String((lastMsg[u.i] & u.mask) ? "On" : "Off") : String("-");
      }
      if (k) out += ',';
      out += "[\"" + label + "\",\"" + val + "\"," + String(unkChgEp[k]) + "," +
             (unkChgMs[k] ? String(millis() - unkChgMs[k]) : String(-1)) + "]";
    }
    out += "],\"l\":[";
    uint32_t cnt = unkLogSeq < UNK_LOG_N ? unkLogSeq : UNK_LOG_N;
    for (uint32_t k = 0; k < cnt; k++) {           // newest first
      const ChangeRec& c = unkLog[(unkLogSeq - 1 - k) % UNK_LOG_N];
      if (k) out += ',';
      out += "[" + String(millis() - c.ms) + "," + String(c.ep) + ",\"" + jsonEsc(c.txt) + "\"]";
    }
    out += "]}";
  }
  out += ",\"last\":" + String(nextSeq - 1);
  out += ",\"frames\":[";
  if (wantFrames) {
    bool first = true;
    for (uint32_t s = start; s < nextSeq; s++) {
      Frame& f = logBuf[s % LOG_FRAMES];
      if (!first) out += ',';
      first = false;
      out += "{\"s\":" + String(s) + ",\"t\":" + String(f.ms) + ",\"h\":\"";
      for (uint16_t i = 0; i < f.len; i++) {
        out += HEXCH[f.data[i] >> 4];
        out += HEXCH[f.data[i] & 0x0F];
      }
      out += "\"}";
    }
  }
  out += "]}";
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json; charset=utf-8", out);
}

void handleSet() {
  if (server.hasArg("baud")) {
    long b = server.arg("baud").toInt();
    if (b >= 50 && b <= 1000000) cfgBaud = (uint32_t)b;
  }
  if (server.hasArg("fmt")) {
    int f = server.arg("fmt").toInt();
    if (f >= 0 && f < FORMAT_COUNT) cfgFmt = (uint8_t)f;
  }
  if (server.hasArg("inv")) cfgInvert = (server.arg("inv").toInt() != 0);
  if (server.hasArg("gap")) {
    long g = server.arg("gap").toInt();
    if (g >= 2 && g <= 10000) cfgGapMs = (uint32_t)g;
  }
  saveSettings();
  restartCapture();
  server.send(200, "text/plain", "OK");
}

// Called from loop(): samples bytes 12/13 once a second and averages the last 60 s.
// The newest of the status frame (type 07) and the fridge's answer (type 02) is used.
void tempTick() {
  static uint32_t lastMs = 0;
  if (millis() - lastMs < 1000) return;
  lastMs = millis();
  iceClockFix();
  if (!haveMsg || dataIsStale()) { tSampN = 0; airTemp = NAN; frzTemp = NAN; return; }
  bool useLive = liveMs && (int32_t)(liveMs - last07Ms) > 0;
  tSamp12[tSampPos] = useLive ? live12 : lastMsg[12];
  tSamp13[tSampPos] = useLive ? live13 : lastMsg[13];
  tSampPos = (tSampPos + 1) % TAVG_N;
  if (tSampN < TAVG_N) tSampN++;
  uint32_t s12 = 0, s13 = 0;
  for (uint8_t i = 0; i < tSampN; i++) { s12 += tSamp12[i]; s13 += tSamp13[i]; }
  float a12 = (float)s12 / tSampN, a13 = (float)s13 / tSampN;
  airTemp = calA - calS * a13 + offFridge;
  frzTemp = frzFromRaw(a12);                  // includes the freezer adjustment
  // Publish when either has moved by 0.1 C or more
  if (isnan(lastPubAir) || isnan(lastPubFrz) || fabsf(airTemp - lastPubAir) >= 0.1f ||
      fabsf(frzTemp - lastPubFrz) >= 0.1f) mqttDirty = true;
}

void handleIceCfg() {
  long s = server.arg("sec").toInt();
  if (s < 0 || s > 1800) { server.send(400, "text/plain", "0 to 30 minutes"); return; }
  cfgIceFullSec = (uint16_t)s;
  prefs.begin("icecfg", false); prefs.putUShort("fullsec", cfgIceFullSec); prefs.end();
  server.send(200, "text/plain", "OK");
}

void handleCal() {
  float f = server.arg("of").toFloat(), z = server.arg("oz").toFloat();
  if (f < -5.0f || f > 5.0f || z < -5.0f || z > 5.0f) {
    server.send(400, "text/plain", "Values out of range"); return;
  }
  offFridge = f; offFreezer = z;
  prefs.begin("cal", false);
  prefs.putFloat("o", offFridge); prefs.putFloat("f", offFreezer);
  prefs.end();
  tSampN = 0;                               // restart the average with the new adjustment
  mqttDirty = true;
  server.send(200, "text/plain", "OK");
}

void handleSaveMqtt() {
  if (server.hasArg("host"))  strlcpy(mqtt_server, server.arg("host").c_str(), sizeof(mqtt_server));
  if (server.hasArg("port")) {
    int p = server.arg("port").toInt();
    mqtt_port = (p > 0 && p <= 65535) ? p : 1883;
  }
  if (server.hasArg("user"))  strlcpy(mqtt_user, server.arg("user").c_str(), sizeof(mqtt_user));
  // Blank password = keep the saved one (unless the user name was cleared too)
  if (server.arg("pass").length() > 0) strlcpy(mqtt_pass, server.arg("pass").c_str(), sizeof(mqtt_pass));
  else if (strlen(mqtt_user) == 0)     mqtt_pass[0] = '\0';
  if (server.hasArg("stale")) {
    long m = server.arg("stale").toInt();
    if (m >= 0 && m <= 1440) cfgStaleMin = (uint16_t)m;
  }
  lastPubStale = -1;                       // re-send data_status after reconnect
  if (server.hasArg("topic") && server.arg("topic").length() > 0) {
    strlcpy(mqtt_topic, server.arg("topic").c_str(), sizeof(mqtt_topic));
  }
  saveSettings();

  if (mqttClient.connected()) mqttClient.disconnect();
  if (strlen(mqtt_server) > 0) mqttClient.setServer(mqtt_server, mqtt_port);
  lastMQTTAttempt = 0;
  server.send(200, "text/plain", "OK");
}

void handleClear() {
  clearLog();
  server.send(200, "text/plain", "OK");
}

// --------------------------------------------------------------------------------
// KEEPALIVE: asks the fridge for its status (type 00) every cfgKaSec seconds
// --------------------------------------------------------------------------------
void kaTick() {
  if (!cfgKaEn) return;
  if (kaLastTickMs && millis() - kaLastTickMs < (uint32_t)cfgKaSec * 1000UL) return;
  kaLastTickMs = millis();
  if (!kaLastTickMs) kaLastTickMs = 1;
  uint8_t buf[MSG_LEN];
  if (haveMsg) memcpy(buf, lastMsg, MSG_LEN);   // the latest status frame
  else { memcpy(buf, KA_DEFAULT, MSG_LEN); buf[4] = lastCounter; }   // none since the restart yet
  buf[4] = lastCounter;                     // the fridge's current counter
  buf[5] = 0x00;                            // message type 00 = "read status"
  uint8_t x = 0; for (int i = 0; i < 29; i++) x ^= buf[i];
  buf[29] = x;
  hwSerial.write(buf, MSG_LEN);
  kaSent++;
  kaLastSent = millis();
  if (!kaLastSent) kaLastSent = 1;
}

void handleKeepalive() {
  cfgKaEn  = server.arg("en") == "1";
  long s = server.arg("sec").toInt();
  if (s >= 2 && s <= 3600) cfgKaSec = (uint16_t)s;
  saveKeepalive();
  kaLastTickMs = 0;                         // send one straight away, then at the new interval
  server.send(200, "text/plain", "OK");
}

// Wi-Fi scan for the setup page. The scan runs in the background:
//   /wifi-scan.json?start=1  starts a new scan
//   /wifi-scan.json          returns {"scanning":1} or the list of networks
void handleWifiScan() {
  int n = WiFi.scanComplete();
  if (server.hasArg("start") && n != WIFI_SCAN_RUNNING) {
    WiFi.scanDelete();
    WiFi.scanNetworks(true);                 // true = asynchronous
    n = WIFI_SCAN_RUNNING;
  }
  server.sendHeader("Cache-Control", "no-store");
  if (n == WIFI_SCAN_RUNNING) { server.send(200, "application/json", "{\"scanning\":1}"); return; }
  String out = "{\"scanning\":0,\"nets\":[";
  bool first = true;
  for (int i = 0; i < n; i++) {
    String ssid = WiFi.SSID(i);
    if (ssid.length() == 0) continue;        // hidden network
    // A mesh shows the same name several times: keep only the strongest one
    bool dup = false;
    for (int j = 0; j < n; j++) {
      if (j != i && WiFi.SSID(j) == ssid &&
          (WiFi.RSSI(j) > WiFi.RSSI(i) || (WiFi.RSSI(j) == WiFi.RSSI(i) && j < i))) { dup = true; break; }
    }
    if (dup) continue;
    if (!first) out += ',';
    first = false;
    out += "{\"s\":\"" + jsonEsc(ssid.c_str()) + "\",\"r\":" + String(WiFi.RSSI(i)) +
           ",\"o\":" + String(WiFi.encryptionType(i) == WIFI_AUTH_OPEN ? 1 : 0) + "}";
  }
  out += "]}";
  server.send(200, "application/json; charset=utf-8", out);
}

void handleSaveWifi() {
  String ssid = server.arg("manual_ssid");
  ssid.trim();
  if (ssid.length() == 0) ssid = server.arg("ssid");
  String pass = server.arg("password");
  if (ssid.length() == 0) { server.send(400, "text/plain", "No network name entered."); return; }
  server.send(200, "text/html; charset=utf-8",
              F("<html><body><h2>Joining new network...</h2><p>The device is saving the new Wi-Fi details and restarting. "
                "If it cannot join, it will come back as the <b>ESP32-Fridge-AP</b> setup network.</p></body></html>"));
  delay(1000);
  WiFi.persistent(true);
  WiFi.begin(ssid.c_str(), pass.c_str());
  delay(1500);
  ESP.restart();
}

void handleResetWifi() {
  server.send(200, "text/html; charset=utf-8",
              F("<html><body><h2>Wi-Fi erased</h2><p>Restarting in AP mode (<b>ESP32-Fridge-AP</b>).</p></body></html>"));
  delay(1000);
  wm.resetSettings();
  delay(500);
  ESP.restart();
}

// --------------------------------------------------------------------------------
// SETUP
// --------------------------------------------------------------------------------
void setup() {
  Serial.begin(115200);
  // Give the PC up to 3 s to open the USB serial port so boot messages are seen
  uint32_t t0 = millis();
  while (!Serial && millis() - t0 < 3000) delay(10);
  Serial.println();
  Serial.println(F("=== Fridge Monitor v" FW_VERSION " booting ==="));

  loadSettings();
  loadKeepalive();
  loadCal();
  loadIce();                                // ice batch total and recent fill times
  prefs.begin("icecfg", true); cfgIceFullSec = prefs.getUShort("fullsec", 240); prefs.end();
  if (cfgIceFullSec > 1800) cfgIceFullSec = 240;
  memset(msgWin, 0xFF, sizeof(msgWin));
  beginFridgeSerial();

  if (strlen(mqtt_server) > 0) mqttClient.setServer(mqtt_server, mqtt_port);
  mqttClient.setSocketTimeout(1);

  server.on("/", HTTP_GET, handleRoot);
  server.on("/diagnostics", HTTP_GET, handleRoot);   // same page file, the script shows the right section
  server.on("/serial", HTTP_GET, handleRoot);
  server.on("/wifi", HTTP_GET, handleRoot);
  server.on("/mqtt", HTTP_GET, handleRoot);          // MQTT is on the Wi-Fi page now
  server.on("/calibration", HTTP_GET, handleRoot);
  server.on("/data.json", HTTP_GET, handleData);
  server.on("/wifi-scan.json", HTTP_GET, handleWifiScan);
  server.on("/save-wifi", HTTP_POST, handleSaveWifi);
  server.on("/resetwifi", HTTP_POST, handleResetWifi);
  server.on("/save-mqtt", HTTP_POST, handleSaveMqtt);
  server.on("/set", HTTP_POST, handleSet);
  server.on("/keepalive", HTTP_POST, handleKeepalive);
  server.on("/cal", HTTP_POST, handleCal);
  server.on("/ice-cfg", HTTP_POST, handleIceCfg);
  server.on("/settings", HTTP_GET, handleRoot);
  server.on("/clear", HTTP_POST, handleClear);
  server.onNotFound([]() { server.send(404, "text/plain", "Not found"); });

  // Non-blocking WiFiManager: loop() keeps running (and keeps printing status)
  // even while the device is waiting in WiFi setup mode.
  Serial.println(F("Connecting to WiFi..."));
  // ESP32-C3 Super Mini fix: many of these boards have a poorly matched antenna
  // and fail to connect at full transmit power. Turning it down fixes that.
  WiFi.mode(WIFI_STA);
  WiFi.setTxPower(WIFI_TX_POWER);

  // Print WHY any connection attempt fails.
  WiFi.onEvent([](WiFiEvent_t event, WiFiEventInfo_t info) {
    int r = info.wifi_sta_disconnected.reason;
    const char* txt = "see ESP32 wifi_err_reason_t list";
    if (r == 201) txt = "NO_AP_FOUND - cannot hear that network at all";
    else if (r == 2 || r == 202) txt = "AUTH failed/expired - router did not answer or rejected us";
    else if (r == 15 || r == 204) txt = "HANDSHAKE_TIMEOUT - usually wrong password or very weak signal";
    else if (r == 200) txt = "BEACON_TIMEOUT - signal too weak / lost";
    else if (r == 203) txt = "ASSOC_FAIL - router refused the association";
    else if (r == 8) txt = "ASSOC_LEAVE - we disconnected ourselves";
    Serial.printf("WiFi DISCONNECT reason %d: %s\n", r, txt);
  }, ARDUINO_EVENT_WIFI_STA_DISCONNECTED);

  // List every network the radio can hear, with signal strength.
  Serial.println(F("Scanning for WiFi networks..."));
  int found = WiFi.scanNetworks();
  if (found <= 0) {
    Serial.println(F("  NO NETWORKS FOUND - the radio/antenna is not receiving anything."));
  } else {
    for (int i = 0; i < found; i++) {
      Serial.printf("  %-28s %4d dBm  ch %d\n", WiFi.SSID(i).c_str(), (int)WiFi.RSSI(i), (int)WiFi.channel(i));
    }
  }
  WiFi.scanDelete();

  wm.setConnectTimeout(45);                 // give up on the saved network after 45 s
  wm.setConfigPortalBlocking(false);
  if (wm.autoConnect("ESP32-Fridge-AP")) startNetServices();
}

// Started once WiFi is connected (the setup portal uses port 80 until then)
void startNetServices() {
  configTzTime("UTC0", "pool.ntp.org", "time.google.com");   // internet time for change timestamps
  WiFi.setTxPower(WIFI_TX_POWER);       // keep the Super Mini fix applied
  ArduinoOTA.setHostname("ESP32-FridgeSniffer");
  ArduinoOTA.begin();                       // also starts mDNS with the hostname above
  MDNS.addService("http", "tcp", 80);       // http://esp32-fridgesniffer.local
  server.begin();
  netStarted = true;
  Serial.println("Connected! Web page: http://" + WiFi.localIP().toString());
}

// --------------------------------------------------------------------------------
// MAIN LOOP
// --------------------------------------------------------------------------------
void loop() {
  tempTick();
  iceBucketTick();
  kaTick();

  if (netStarted) {
    ArduinoOTA.handle();
    server.handleClient();

    // Wi-Fi watchdog
    static uint32_t wifiLostMs = 0, lastKickMs = 0;
    if (WiFi.status() == WL_CONNECTED) {
      wifiLostMs = 0;
    } else {
      uint32_t now = millis();
      if (wifiLostMs == 0) { wifiLostMs = now ? now : 1; lastKickMs = wifiLostMs; }
      if (now - wifiLostMs > 300000UL) {
        Serial.println(F("Wi-Fi lost for 5 minutes - restarting."));
        delay(200);
        ESP.restart();
      }
      if (now - lastKickMs > 30000UL) {
        lastKickMs = now;
        Serial.println(F("Wi-Fi lost - forcing a reconnect."));
        WiFi.reconnect();
      }
    }

    // MQTT: keep connected, publish whenever the fridge state changes
    if (strlen(mqtt_server) > 0) {
      if (!mqttClient.connected()) {
        // Only try while Wi-Fi is up: a connect attempt blocks the loop, and
        // with no network it would block for its full timeout every time.
        if (WiFi.status() == WL_CONNECTED &&
            (lastMQTTAttempt == 0 || millis() - lastMQTTAttempt > 15000)) {
          lastMQTTAttempt = millis();
          if (lastMQTTAttempt == 0) lastMQTTAttempt = 1;
          reconnectMQTT();
        }
      } else {
        mqttClient.loop();
        if ((dataIsStale() ? 1 : 0) != lastPubStale) publishDataStatus();
        // Uptime for Home Assistant: refresh the state every 5 minutes
        if (millis() - lastPubMs >= 300000UL) mqttDirty = true;
        if (mqttDirty) {
          // Door / mode changes go out immediately; everything else is
          // limited to one publish per second.
          bool urgent = haveMsg && (lastMsg[18] != lastPubB18 || lastMsg[16] != lastPubB16 ||
                                    lastMsg[8] != lastPubB8 || lastMsg[17] != lastPubB17);
          if (urgent || millis() - lastPubMs >= 1000) { mqttDirty = false; publishState(); }
        }
        // Undecoded bytes/bits: when they change (and once the first message is in)
        if (unkDirty && haveMsg) publishUnknown();
        // Change log: every change goes out in order (oldest first)
        if (chgSeq - chgPubSeq > CHG_N) chgPubSeq = chgSeq - CHG_N;
        while (chgPubSeq < chgSeq) {
          publishChange(chgLog[chgPubSeq % CHG_N], chgPubSeq + 1);
          chgPubSeq++;
        }
      }
    }
  } else {
    wm.process();                                         // WiFi setup portal
    // The saved network can still join in the background while setup mode is
    // running (slow joins). As soon as that happens, close the setup access
    // point and start the real web page.
    static uint32_t connectedSince = 0;
    if (WiFi.status() == WL_CONNECTED) {
      if (connectedSince == 0) connectedSince = millis();
      if (millis() - connectedSince >= 3000) {            // stable for 3 s
        if (wm.getConfigPortalActive()) {
          Serial.println(F("WiFi joined - closing setup access point."));
          wm.stopConfigPortal();
          WiFi.mode(WIFI_STA);
        }
        startNetServices();
      }
    } else {
      connectedSince = 0;
    }
    // 3 min in setup mode with nobody connected to the setup network:
    // restart and try the saved Wi-Fi again.
    if (!netStarted && millis() > 180000UL && WiFi.softAPgetStationNum() == 0) {
      Serial.println(F("Setup mode timed out - restarting to retry the saved Wi-Fi."));
      delay(200);
      ESP.restart();
    }
  }

  // Print the status on USB serial every 5 seconds so it is easy to find
  static uint32_t lastIpPrint = 0;
  if (millis() - lastIpPrint >= 5000) {
    lastIpPrint = millis();
    if (!netStarted) {
      Serial.println(F("SETUP MODE: not on your WiFi yet. Join the WiFi network 'ESP32-Fridge-AP' "
                       "with a phone or PC and browse to http://192.168.4.1 to enter your WiFi details."));
    } else if (WiFi.status() == WL_CONNECTED) {
      Serial.println("Web page: http://" + WiFi.localIP().toString() +
                     "  or  http://esp32-fridgesniffer.local   (WiFi: " + WiFi.SSID() +
                     ", " + String(WiFi.RSSI()) + " dBm)");
    } else {
      Serial.println(F("WiFi not connected - trying to reconnect..."));
    }
  }

  // The ESP32 serial driver can stop receiving after its buffer overflows
  // (for example if the loop was held up). Restart the port to recover.
  if (uartNeedsRestart) {
    uartNeedsRestart = false;
    uartRestarts++;
    Serial.println(F("Restarting the fridge serial port."));
    hwSerial.end();
    delay(20);
    beginFridgeSerial();
    memset(msgWin, 0xFF, sizeof(msgWin));
    curLen = 0;
  }

  // Signal monitor: watch the pin itself. If the line is toggling but the
  // serial port delivers no bytes, the port is stuck - restart it.
  int lv = gpio_get_level((gpio_num_t)RX_PIN);
  if (lv != lineLevel) { lineLevel = lv; lineEdges++; lastLineEdgeMs = millis(); anyEdge = true; }
  static uint32_t wdMs = 0, wdEdges = 0, wdBytes = 0, lastFixMs = 0;
  static uint8_t strikes = 0;
  if (millis() - wdMs >= 5000) {
    bool stuck = (lineEdges - wdEdges >= 20) && (rxByteCount == wdBytes);
    wdMs = millis(); wdEdges = lineEdges; wdBytes = rxByteCount;
    strikes = stuck ? strikes + 1 : 0;
    if (strikes >= 2 && millis() - lastFixMs > 20000) {
      strikes = 0;
      lastFixMs = millis();
      portFixes++;
      Serial.println(F("Signal present on the pin but no bytes received."));
      uartNeedsRestart = true;
    }
  }

  // 1. Read incoming bytes
  while (hwSerial.available()) {
    uint8_t b = hwSerial.read();
    feedDecoder(b);
    rxByteCount++; lastByteMs = millis(); anyByte = true;
    if (curLen == 0) curStartMs = millis();
    curBuf[curLen++] = b;
    totalBytes++;
    lastRxMs = millis();
    if (curLen >= FRAME_MAX) flushFrame();   // long burst: wrap onto a new line
  }

  // 2. Bus silent for the gap time -> close the frame
  if (curLen > 0 && (millis() - lastRxMs >= cfgGapMs)) flushFrame();
}

