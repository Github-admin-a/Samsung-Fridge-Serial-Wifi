    h+='<tr><td>'+esc(x[0])+'</td><td class="v">'+esc(x[1])+'</td><td'+(ch?' class="ch"':'')+'>'+(ch?(x[2]?dtShort(x[2]):ago(x[3])):'<span style="color:#888">No change</span>')+'</td></tr>';});
