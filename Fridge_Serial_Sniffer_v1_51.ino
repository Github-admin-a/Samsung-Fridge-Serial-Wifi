// --------------------------------------------------------------------------------
// CLOCK (internet time, used to timestamp changes)
// --------------------------------------------------------------------------------
bool clockValid() { return time(nullptr) > 1700000000; }
uint32_t epochNow() { return (uint32_t)time(nullptr); }
uint32_t uptimeSec() { return (uint32_t)(esp_timer_get_time() / 1000000ULL); }

String isoUtc(uint32_t e) {
  if (!e) return String("");
  time_t t = e; struct tm g; gmtime_r(&t, &g);
  char b[32]; strftime(b, sizeof(b), "%Y-%m-%dT%H:%M:%S+00:00", &g);
  return String(b);
}

// --------------------------------------------------------------------------------
// FRIDGE MESSAGE DECODER
//   Message = 31 bytes: 02 96 .... [29]=XOR of bytes 0..28, [30]=00
// --------------------------------------------------------------------------------
#define MSG_LEN 31
uint8_t  msgWin[MSG_LEN];       // sliding window over the incoming byte stream
uint8_t  lastMsg[MSG_LEN];      // most recent valid status message (type 07)
bool     haveMsg = false;
uint32_t lastMsgMs = 0;         // last valid message of any type
uint8_t  live12 = 0, live13 = 0;   // sensor bytes from the latest type 02 answer
uint32_t liveMs = 0;               // when that answer arrived (0 = none yet)
uint32_t last07Ms = 0;             // when the latest status frame (type 07) arrived
uint32_t badCount = 0;          // messages with a checksum failure
uint32_t lastAnswerMs = 0;      // last type 02 answer from the fridge
uint32_t kaSent = 0, kaLastSent = 0;   // keepalives sent, and when the last one went out
uint32_t kaLastTickMs = 0;
uint8_t  lastCounter = 0;       // byte 4 of the latest valid frame of any type
// Built-in status frame for the keepalive, used until the fridge has sent its own
const uint8_t KA_DEFAULT[31] = {0x02,0x96,0x03,0x41,0x00,0x07,0x00,0x54,0x00,0x24,0x90,0x03,0xBA,0x7A,0x14,0x3C,
  0xB2,0x21,0x00,0x00,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x00,0x00};
uint32_t lastPubMs = 0;         // MQTT rate limiting
uint8_t  lastPubB18 = 0, lastPubB16 = 0, lastPubB8 = 0, lastPubB17 = 0;
int      fridgeTemp = 0;        // last fridge temperature seen outside settings mode
bool     haveFridgeTemp = false;
int      freezerTemp = 0;       // last freezer temperature seen outside freezer settings mode
bool     haveFreezerTemp = false;

// Dispenser selection (byte 8)
const char* dispenserMode(uint8_t b) {
  switch (b & 0x06) {               // bits 0x02 (water) and 0x04 (cubed) only
    case 0x00: return "Crushed ice";
    case 0x04: return "Cubed ice";
    default:   return "Water";      // 0x02 / 0x06: water (reached from either ice type)
  }
}

// What the dispenser is putting out right now (byte 17 0x04 + ice type in byte 8)
const char* dispensingText(const uint8_t* m) {
  if (!(m[17] & 0x04)) return "Off";
  switch (m[8] & 0x06) {
    case 0x00: return "Crushed ice";
    case 0x04: return "Cubed ice";
    default:   return "Ice";
  }
}

// Byte 17 low 2 bits: what is being cooled
const char* coolMode(uint8_t b17) {
  switch (b17 & 0x03) {
    case 0: return "Idle";
    case 1: return "Fridge";
    case 2: return "Freezer";
    default: return "Both";
  }
}

int smTemp(uint8_t b) { return (b & 0x80) ? -(int)(b & 0x7F) : (int)b; }

// Set temperatures from byte 9
int fridgeSetFromB9(uint8_t b9, bool& ok) { int a = b9 & 0x0F; ok = (a <= 6); return 7 - a; }
int freezerSetFromB9(uint8_t b9, bool& ok) { int a = b9 >> 4; ok = (a <= 11); return -(14 + a); }

// --------------------------------------------------------------------------------
// TEMPERATURES FROM THE RAW SENSOR BYTES
//   Fridge air  = A - S x byte 13  (calibrated against an Inkbird logger)
//   Freezer     = NTC model of byte 12 (same thermistor type, estimate)
//   Plus the adjustment set on the Calibration page.
// --------------------------------------------------------------------------------
float calA = 44.6f, calS = 0.31f;       // fixed fridge conversion (from the earlier calibration)
float offFridge = 0.0f;                 // Calibration page: fridge adjustment (C)
float offFreezer = 0.0f;                // Calibration page: freezer adjustment (C)
#define TAVG_N 60                       // 60 one-second samples
uint8_t  tSamp12[TAVG_N], tSamp13[TAVG_N];
uint8_t  tSampN = 0, tSampPos = 0;
float    airTemp = NAN, frzTemp = NAN;  // averaged, calibrated
float    lastPubAir = NAN, lastPubFrz = NAN;
float frzFromRaw(float c) {
  if (c < 1) c = 1;
  if (c > 254) c = 254;
  float x = c / (255.0f - c);           // thermistor / divider resistor
  float invT = 1.0f / 298.15f + logf(x / 0.39f) / 3920.0f;
  return 1.0f / invT - 273.15f + offFreezer;
}

// --------------------------------------------------------------------------------
// RECENT CHANGES: only things worth knowing about, described in words
// --------------------------------------------------------------------------------
ChangeRec chgLog[CHG_N];
uint32_t  chgSeq = 0;       // changes recorded since boot
uint32_t  chgPubSeq = 0;    // changes already sent to MQTT

static void chgAdd(String& s, const String& part) { if (s.length()) s += "; "; s += part; }
static String hx2(uint8_t v) { char b[6]; snprintf(b, sizeof b, "0x%02X", v); return String(b); }

// Bytes and bits not decoded yet. They are sent to Home Assistant (<prefix>/unknown)
// but kept off the web page and out of Recent Changes.
struct UnkBit { uint8_t i; uint8_t mask; };
const UnkBit  UNK_BITS[]  = {{8, 0x40}, {16, 0x01}, {17, 0x08}, {17, 0x10}, {18, 0x01}, {18, 0x08}, {18, 0x20},
                             {19, 0x01}, {19, 0x02}, {19, 0x08}, {19, 0x10}, {19, 0x20}, {19, 0x40}, {19, 0x80}};
const uint8_t UNK_BYTES[] = {6, 7, 14, 15};
#define UNK_FIRST 20                    // bytes 20..28 are reported together
#define UNK_LAST  28
String   unkLastChange;                 // what last changed, in words
uint32_t unkLastEp = 0;                 // when (epoch seconds, 0 = clock not set)
bool     unkDirty = true;               // something changed: publish /unknown

// When each undecoded item last changed (index: bytes, then bytes 20-28, then bits)
const uint8_t UNK_NBYTES = sizeof(UNK_BYTES);
const uint8_t UNK_NBITS  = sizeof(UNK_BITS) / sizeof(UNK_BITS[0]);
const uint8_t UNK_N      = UNK_NBYTES + 1 + UNK_NBITS;
uint32_t unkChgMs[UNK_N];               // millis() of the last change (0 = none since restart)
uint32_t unkChgEp[UNK_N];               // epoch seconds of the last change (0 = clock not set / none)
// Log of the last undecoded changes, for the Diagnostics page
#define UNK_LOG_N 10
ChangeRec unkLog[UNK_LOG_N];
uint32_t  unkLogSeq = 0;

static void unkMark(uint8_t idx) {
  unkChgMs[idx] = millis() ? millis() : 1;
  unkChgEp[idx] = clockValid() ? epochNow() : 0;
}

void recordUnknown(const uint8_t* o, const uint8_t* n) {
  String s;
  for (uint8_t k = 0; k < UNK_NBYTES; k++) {
    uint8_t i = UNK_BYTES[k];
    if (o[i] != n[i]) { chgAdd(s, "Byte " + String(i) + ": " + hx2(o[i]) + " -> " + hx2(n[i])); unkMark(k); }
  }
  for (uint8_t i = UNK_FIRST; i <= UNK_LAST; i++)
    if (o[i] != n[i]) { chgAdd(s, "Byte " + String(i) + ": " + hx2(o[i]) + " -> " + hx2(n[i])); unkMark(UNK_NBYTES); }
  for (uint8_t k = 0; k < UNK_NBITS; k++) {
    const UnkBit& u = UNK_BITS[k];
    if ((o[u.i] ^ n[u.i]) & u.mask) {
      chgAdd(s, "Byte " + String(u.i) + " bit " + hx2(u.mask) + ((n[u.i] & u.mask) ? " on" : " off"));
      unkMark(UNK_NBYTES + 1 + k);
    }
  }
  if (s.length() == 0) return;
  unkLastChange = s;
  unkLastEp = clockValid() ? epochNow() : 0;
  unkDirty = true;
  ChangeRec& c = unkLog[unkLogSeq % UNK_LOG_N];
  c.ms = millis();
  c.ep = unkLastEp;
  strncpy(c.txt, s.c_str(), CHG_TXT - 1);
  c.txt[CHG_TXT - 1] = 0;
  unkLogSeq++;
  Serial.printf("Unknown change: %s\n", s.c_str());
}

void chgPush(const String& s) {
  ChangeRec& c = chgLog[chgSeq % CHG_N];
  c.ms  = millis();
  c.ep  = clockValid() ? epochNow() : 0;
  strncpy(c.txt, s.c_str(), CHG_TXT - 1);
  c.txt[CHG_TXT - 1] = 0;
  chgSeq++;
  Serial.printf("Change: %s\n", c.txt);
}

void recordChange(const uint8_t* o, const uint8_t* n) {
  String s;
  // Byte 8: dispenser selection and the on/off settings
  {
    uint8_t d = o[8] ^ n[8];
    if ((d & 0x06) && strcmp(dispenserMode(o[8]), dispenserMode(n[8])) != 0)
      chgAdd(s, String("Dispenser: ") + dispenserMode(o[8]) + " -> " + dispenserMode(n[8]));
    if (d & 0x80) chgAdd(s, (n[8] & 0x80) ? "Power Freeze on" : "Power Freeze off");
    if (d & 0x08) chgAdd(s, (n[8] & 0x08) ? "Ice Off on" : "Ice Off off (ice maker on)");
    if (d & 0x01) chgAdd(s, (n[8] & 0x01) ? "Lighting on" : "Lighting off");
    if (d & 0x10) chgAdd(s, (n[8] & 0x10) ? "Child Lock on" : "Child Lock off");
    if (d & 0x20) chgAdd(s, (n[8] & 0x20) ? "Vacation mode on" : "Vacation mode off");
  }
  // Byte 9: set temperatures
  if ((o[9] & 0x0F) != (n[9] & 0x0F)) {
    bool a, b;
    int x = fridgeSetFromB9(o[9], a), y = fridgeSetFromB9(n[9], b);
    chgAdd(s, "Fridge set temperature: " + (a ? String(x) : String("?")) + " -> " + (b ? String(y) : String("?")) + " C");
  }
  if ((o[9] >> 4) != (n[9] >> 4)) {
    bool a, b;
    int x = freezerSetFromB9(o[9], a), y = freezerSetFromB9(n[9], b);
    chgAdd(s, "Freezer set temperature: " + (a ? String(x) : String("?")) + " -> " + (b ? String(y) : String("?")) + " C");
  }
  // Bytes 10 / 11: displayed temperatures (they show the setting while in settings mode)
  if (o[10] != n[10] && !((o[18] | n[18]) & 0x04))
    chgAdd(s, "Freezer temperature: " + String(smTemp(o[10])) + " -> " + String(smTemp(n[10])) + " C");
  if (o[11] != n[11] && !((o[18] | n[18]) & 0x02))
    chgAdd(s, "Fridge temperature: " + String(smTemp(o[11])) + " -> " + String(smTemp(n[11])) + " C");
  // Byte 16: compressor
  if ((o[16] ^ n[16]) & 0x80) chgAdd(s, (n[16] & 0x80) ? "Compressor started" : "Compressor stopped");
  // Byte 17: dispenser, defrost, cooling hold, gateway link
  if ((o[17] ^ n[17]) & 0x04) {
    String what = (n[17] & 0x04) ? dispensingText(n) : dispensingText(o);
    what.toLowerCase();
    chgAdd(s, String((n[17] & 0x04) ? "Dispensing " : "Stopped dispensing ") + what);
  }
  if ((o[17] ^ n[17]) & 0x80) chgAdd(s, (n[17] & 0x80) ? "Defrost heater on" : "Defrost heater off");
  if ((o[17] ^ n[17]) & 0x40) chgAdd(s, (n[17] & 0x40) ? "Cooling hold on" : "Cooling hold off");
  if ((o[17] ^ n[17]) & 0x20) chgAdd(s, (n[17] & 0x20) ? "Gateway link on" : "Gateway link off");
  // Byte 18: doors, ice bucket
  {
    uint8_t d = o[18] ^ n[18];
    if (d & 0x40) chgAdd(s, (n[18] & 0x40) ? "Fridge door opened" : "Fridge door closed");
    if (d & 0x80) chgAdd(s, (n[18] & 0x80) ? "Freezer door opened" : "Freezer door closed");
  }
  if (s.length() == 0) return;          // only fans, counters and other minor bytes changed
  chgPush(s);
}

// --------------------------------------------------------------------------------
// ICE MAKER FILL DETECTION
//   While the ice tray fills, the freezer fan (byte 16 0x40/0x20) stops for
//   ~36 s with the compressor on (0x80), doors shut and no defrost/hold.
// --------------------------------------------------------------------------------
#define ICE_HIST 48
uint16_t cfgIceFullSec = 240;          // "ice bucket full" must stay on this long to count (Settings page):
                                       // the ice maker's level checks set it for up to ~3 min
#define ICE_CUBES_PER_FILL 7           // cubes the ice tray makes per batch
// Recent fills (ring). The times are saved in flash so the rolling 24 h count
// carries on through restarts. A fill made before the clock was set has
// iceFillEp = 0 and is timed by millis() until the clock is set (iceClockFix).
uint32_t iceFillEp[ICE_HIST];          // epoch seconds of recent fills (0 = not known yet)
uint32_t iceFillMs[ICE_HIST];          // millis() of fills since this restart (0 = from before)
uint8_t  iceFillN = 0, iceFillPos = 0;
uint32_t iceFillTotal = 0;             // all-time batches (saved in flash)
uint32_t iceFillLastMs = 0, iceFillLastEp = 0;
bool     icePause = false, icePauseOk = false;
uint32_t icePauseStartMs = 0;

void saveIce() {
  prefs.begin("ice", false);
  prefs.putUInt("total", iceFillTotal);
  prefs.putUInt("last", iceFillLastEp);
  prefs.putUChar("n", iceFillN);
  prefs.putUChar("pos", iceFillPos);
  prefs.putBytes("eps", iceFillEp, sizeof(iceFillEp));
  prefs.end();
}

void loadIce() {
  prefs.begin("ice", true);
  iceFillTotal  = prefs.getUInt("total", 0);
  iceFillLastEp = prefs.getUInt("last", 0);
  iceFillN      = prefs.getUChar("n", 0);
  iceFillPos    = prefs.getUChar("pos", 0);
  if (prefs.getBytesLength("eps") != sizeof(iceFillEp)) iceFillN = 0;
  else prefs.getBytes("eps", iceFillEp, sizeof(iceFillEp));
  prefs.end();
  if (iceFillN > ICE_HIST || iceFillPos >= ICE_HIST) { iceFillN = 0; iceFillPos = 0; }
  memset(iceFillMs, 0, sizeof(iceFillMs));
}

// Once the clock is set, give a real time to fills made before that, and save them
void iceClockFix() {
  if (!clockValid()) return;
  bool changed = false;
  for (uint8_t i = 0; i < iceFillN; i++)
    if (!iceFillEp[i] && iceFillMs[i]) { iceFillEp[i] = epochNow() - (millis() - iceFillMs[i]) / 1000; changed = true; }
  if (!iceFillLastEp && iceFillLastMs) { iceFillLastEp = epochNow() - (millis() - iceFillLastMs) / 1000; changed = true; }
  if (changed) { saveIce(); mqttDirty = true; }
}

// Ice bucket full, ignoring the short level checks (byte 18 bit 0x10 on for under 4 min)
bool     iceRawFull = false, iceFull = false;
uint32_t iceRawOnMs = 0;
void iceBucketTick() {
  if (!haveMsg) return;
  bool raw = lastMsg[18] & 0x10;
  if (raw && !iceRawFull) iceRawOnMs = millis();
  iceRawFull = raw;
  bool full = raw && millis() - iceRawOnMs >= (uint32_t)cfgIceFullSec * 1000UL;
  if (full != iceFull) {
    iceFull = full;
    chgPush(full ? "Ice bucket full" : "Ice bucket not full");
    mqttDirty = true;
  }
}

uint16_t iceFills24h() {
  uint16_t c = 0;
  bool cv = clockValid();
  uint32_t now = cv ? epochNow() : 0;
  for (uint8_t i = 0; i < iceFillN; i++) {
    if (iceFillEp[i]) { if (cv && now - iceFillEp[i] < 86400UL) c++; }
    else if (iceFillMs[i] && millis() - iceFillMs[i] < 86400000UL) c++;
  }
  return c;
}

// Called for every new (changed) status message
void iceFillCheck(const uint8_t* o, const uint8_t* n) {
  bool fzWas = o[16] & 0x60, fzNow = n[16] & 0x60;
  bool okNow = (n[16] & 0x80) && !(n[18] & 0xC0) && !(n[17] & 0xC0);
  if (fzWas && !fzNow) {                      // freezer fan just stopped
    icePause = true;
    icePauseOk = okNow;
    icePauseStartMs = millis();
  } else if (icePause && !fzNow) {
    if (!okNow) icePauseOk = false;           // door, compressor off or defrost
  } else if (icePause && fzNow) {              // fan back on
    icePause = false;
    uint32_t d = millis() - icePauseStartMs;
    if (icePauseOk && d >= 25000 && d <= 50000) {
      iceFillMs[iceFillPos] = millis() ? millis() : 1;
      iceFillEp[iceFillPos] = clockValid() ? epochNow() : 0;
      iceFillPos = (iceFillPos + 1) % ICE_HIST;
      if (iceFillN < ICE_HIST) iceFillN++;
      iceFillTotal++;
      iceFillLastMs = millis() ? millis() : 1;
      iceFillLastEp = clockValid() ? epochNow() : 0;
      saveIce();                                // kept through restarts
      chgPush("Ice maker fill");
      mqttDirty = true;
    }
  }
}

// Called for every incoming byte: finds valid 31-byte messages in the stream
void feedDecoder(uint8_t b) {
  memmove(msgWin, msgWin + 1, MSG_LEN - 1);
  msgWin[MSG_LEN - 1] = b;
  if (msgWin[0] != 0x02 || msgWin[1] != 0x96 || msgWin[MSG_LEN - 1] != 0x00) return;
  uint8_t x = 0;
  for (uint8_t i = 0; i < MSG_LEN - 2; i++) x ^= msgWin[i];
  if (x != msgWin[MSG_LEN - 2]) { badCount++; return; }
  lastMsgMs = millis();
  lastCounter = msgWin[4];
  // Not a status message (byte 5 = 0x07): answers to our requests, start-up frame
  if (msgWin[5] != 0x07) {
    if (msgWin[5] == 0x02) {
      // The fridge's answer to a request carries live sensor bytes 12/13
      lastAnswerMs = millis();
      live12 = msgWin[12]; live13 = msgWin[13]; liveMs = millis();
      // No status frame since the restart yet: the answer has the same layout, so use it
      if (!haveMsg) {
        memcpy(lastMsg, msgWin, MSG_LEN);
        lastMsg[5] = 0x07;
        uint8_t c = 0; for (uint8_t i = 0; i < MSG_LEN - 2; i++) c ^= lastMsg[i];
        lastMsg[MSG_LEN - 2] = c;
        if (!(lastMsg[18] & 0x02)) { fridgeTemp = smTemp(lastMsg[11]); haveFridgeTemp = true; }
        if (!(lastMsg[18] & 0x04)) { freezerTemp = smTemp(lastMsg[10]); haveFreezerTemp = true; }
        haveMsg = true;
        mqttDirty = true;
      }
    }
    return;
  }
  last07Ms = millis();
  // Byte 11 shows the 1-7 setting instead of the temperature in settings mode
  if (!(msgWin[18] & 0x02)) { fridgeTemp = smTemp(msgWin[11]); haveFridgeTemp = true; }
  // Byte 10 shows the freezer SET temperature while freezer settings mode is on
  if (!(msgWin[18] & 0x04)) { freezerTemp = smTemp(msgWin[10]); haveFreezerTemp = true; }
  if (!haveMsg || memcmp(msgWin, lastMsg, MSG_LEN) != 0) {
    if (haveMsg) { recordChange(lastMsg, msgWin); recordUnknown(lastMsg, msgWin); iceFillCheck(lastMsg, msgWin); }
    memcpy(lastMsg, msgWin, MSG_LEN);
    haveMsg = true;
    mqttDirty = true;
  }
}

// ESP32 replacement for ESP.getChipId(): last 3 bytes of the MAC address
String getChipIdHex() {
  uint32_t chipId = 0;
  for (int i = 0; i < 17; i += 8) {
    chipId |= ((ESP.getEfuseMac() >> (40 - i)) & 0xff) << i;
  }
  return String(chipId, HEX);
}

// Escapes a string for safe use inside a JSON string value
String jsonEsc(const char* in) {
  String out;
  for (const char* p = in; *p; p++) {
    if (*p == '"' || *p == '\\') { out += '\\'; out += *p; }
    else if ((uint8_t)*p >= 0x20) out += *p;
  }
  return out;
}

String msgHex() {
  static const char H[] = "0123456789ABCDEF";
  String out;
  if (!haveMsg) return out;
  out.reserve(MSG_LEN * 2);
  for (uint8_t i = 0; i < MSG_LEN; i++) {
    out += H[lastMsg[i] >> 4];
    out += H[lastMsg[i] & 0x0F];
  }
  return out;
}

// --------------------------------------------------------------------------------
// SERIAL PORT
// --------------------------------------------------------------------------------
void onUartError(hardwareSerial_error_t e) {
  switch (e) {
    case UART_FRAME_ERROR:       errFrame++;    break;
    case UART_PARITY_ERROR:      errParity++;   break;
    case UART_BREAK_ERROR:       errBreak++;    break;
    case UART_FIFO_OVF_ERROR:
    case UART_BUFFER_FULL_ERROR: errOverflow++; uartNeedsRestart = true; break;
    default: break;
  }
}

void beginFridgeSerial() {
  hwSerial.setRxBufferSize(4096);         // must be set before begin()
  hwSerial.begin(cfgBaud, FORMAT_CFG[cfgFmt], RX_PIN, TX_PIN, cfgInvert);
  hwSerial.setRxFIFOFull(1);              // hand over each byte as it arrives
  // The serial driver turns on a weak (~45k) pull-up to 3.3V on the RX pin.
  // Switch it off so the only thing touching the fridge's line is the converter.
  gpio_pullup_dis((gpio_num_t)RX_PIN);
  gpio_pulldown_dis((gpio_num_t)RX_PIN);
  hwSerial.onReceiveError(onUartError);
}

void clearLog() {
  curLen = 0;
  firstSeq = nextSeq;
  totalBytes = 0;
  errFrame = errParity = errBreak = errOverflow = 0;
  epoch++;
}

void restartCapture() {
  hwSerial.end();
  beginFridgeSerial();
  memset(msgWin, 0xFF, sizeof(msgWin));
  clearLog();
}

void flushFrame() {
  if (curLen == 0) return;
  Frame& f = logBuf[nextSeq % LOG_FRAMES];
  f.ms  = curStartMs;
  f.len = curLen;
  memcpy(f.data, curBuf, curLen);
  nextSeq++;
  curLen = 0;
}

// --------------------------------------------------------------------------------
// SETTINGS STORAGE
// --------------------------------------------------------------------------------
void loadSettings() {
  prefs.begin("fridge", true);
  cfgBaud   = prefs.getUInt("baud", 9600);
  cfgFmt    = prefs.getUChar("fmt", 0);
  cfgInvert = prefs.getBool("inv", false);
  cfgGapMs  = prefs.getUInt("gap", 30);
  strlcpy(mqtt_server, prefs.getString("mhost", "").c_str(), sizeof(mqtt_server));
  mqtt_port = prefs.getInt("mport", 1883);
  strlcpy(mqtt_user, prefs.getString("muser", "").c_str(), sizeof(mqtt_user));
  strlcpy(mqtt_pass, prefs.getString("mpass", "").c_str(), sizeof(mqtt_pass));
  strlcpy(mqtt_topic, prefs.getString("mtopic", "homeassistant/sensor/fridge").c_str(), sizeof(mqtt_topic));
  cfgStaleMin = prefs.getUShort("stalemin", 30);
  prefs.end();
  if (mqtt_port <= 0 || mqtt_port > 65535) mqtt_port = 1883;
  if (strlen(mqtt_topic) == 0) strlcpy(mqtt_topic, "homeassistant/sensor/fridge", sizeof(mqtt_topic));
  if (cfgFmt >= FORMAT_COUNT) cfgFmt = 0;
  if (cfgBaud < 50 || cfgBaud > 1000000) cfgBaud = 9600;
  if (cfgGapMs < 2 || cfgGapMs > 10000) cfgGapMs = 30;
}

void saveSettings() {
  prefs.begin("fridge", false);
  prefs.putUInt("baud", cfgBaud);
  prefs.putUChar("fmt", cfgFmt);
  prefs.putBool("inv", cfgInvert);
  prefs.putUInt("gap", cfgGapMs);
  prefs.putString("mhost", mqtt_server);
  prefs.putInt("mport", mqtt_port);
  prefs.putString("muser", mqtt_user);
  prefs.putString("mpass", mqtt_pass);
  prefs.putString("mtopic", mqtt_topic);
  prefs.putUShort("stalemin", cfgStaleMin);
  prefs.end();
}

// Keepalive settings. The first time, the interval saved by the earlier test
// sketches (under "autotx") is taken over, so a 90 s keepalive carries on as it was.
void loadKeepalive() {
  prefs.begin("keepalive", true);
  bool have = prefs.isKey("sec");
  cfgKaEn  = prefs.getBool("en", true);
  cfgKaSec = prefs.getUShort("sec", 90);
  prefs.end();
  if (!have) {
    prefs.begin("autotx", true);
    if (prefs.isKey("kasec")) cfgKaSec = prefs.getUShort("kasec", 90);
    prefs.end();
    cfgKaEn = true;                         // the keepalive is what keeps the fridge talking
  }
  if (cfgKaSec < 2 || cfgKaSec > 3600) cfgKaSec = 90;
}

void saveKeepalive() {
  prefs.begin("keepalive", false);
  prefs.putBool("en", cfgKaEn);
  prefs.putUShort("sec", cfgKaSec);
  prefs.end();
}

void loadCal() {
  prefs.begin("cal", true);
  calA       = prefs.getFloat("a", 44.6f);       // fixed conversion from the earlier calibration
  calS       = prefs.getFloat("s", 0.31f);
  offFreezer = prefs.getFloat("f", 0.0f);         // freezer adjustment (was the freezer offset)
  offFridge  = prefs.getFloat("o", 0.0f);         // fridge adjustment
  prefs.end();
  if (calS <= 0 || calS > 5) { calA = 44.6f; calS = 0.31f; }
  if (offFridge < -5 || offFridge > 5) offFridge = 0;
  if (offFreezer < -5 || offFreezer > 5) offFreezer = 0;
}

// True when no fridge message has arrived within the stale time (or none yet)
bool dataIsStale() {
  if (!haveMsg) return true;
  if (cfgStaleMin == 0) return false;
  return (millis() - lastMsgMs) > (uint32_t)cfgStaleMin * 60000UL;
}

void publishDataStatus() {
  bool st = dataIsStale();
  String t = String(mqtt_topic) + "/data_status";
  mqttClient.publish(t.c_str(), st ? "offline" : "online", true);
  lastPubStale = st ? 1 : 0;
}

// --------------------------------------------------------------------------------
// MQTT: STATE PUBLISHER
// --------------------------------------------------------------------------------
void publishState() {
  if (!haveMsg || !mqttClient.connected()) return;
  const uint8_t* m = lastMsg;

  JsonDocument doc;
  doc["fridge_door"]   = (m[18] & 0x40) != 0;
  doc["freezer_door"]  = (m[18] & 0x80) != 0;
  doc["settings_mode"] = (m[18] & 0x06) != 0;   // 0x02 fridge, 0x04 freezer
  bool ok;
  int fz = freezerSetFromB9(m[9], ok);
  if (ok) doc["freezer_set_temp"] = fz; else doc["freezer_set_temp"] = nullptr;
  int fr = fridgeSetFromB9(m[9], ok);
  if (ok) doc["fridge_set_temp"] = fr; else doc["fridge_set_temp"] = nullptr;
  if (haveFridgeTemp) doc["fridge_temp"] = fridgeTemp;
  else                doc["fridge_temp"] = nullptr;
  if (haveFreezerTemp) doc["freezer_temp"] = freezerTemp;
  else                 doc["freezer_temp"] = nullptr;
  if (!isnan(airTemp)) doc["fridge_air_temp"] = roundf(airTemp * 10) / 10.0f;
  else                  doc["fridge_air_temp"] = nullptr;
  if (!isnan(frzTemp)) doc["freezer_est_temp"] = roundf(frzTemp * 10) / 10.0f;
  else                  doc["freezer_est_temp"] = nullptr;
  lastPubAir = airTemp; lastPubFrz = frzTemp;
  doc["dispenser_selection"] = dispenserMode(m[8]);
  doc["power_freeze"] = (m[8] & 0x80) != 0;
  doc["ice_off"]      = (m[8] & 0x08) != 0;
  doc["lighting"]     = (m[8] & 0x01) != 0;
  doc["child_lock"]   = (m[8] & 0x10) != 0;
  doc["vacation"]     = (m[8] & 0x20) != 0;
  doc["dispenser_active"] = (m[17] & 0x04) != 0;   // ice dispensing
  doc["dispensing"]   = dispensingText(m);
  doc["compressor"]   = (m[16] & 0x80) != 0;
  doc["fridge_fan"]   = (m[16] & 0x18) != 0;   // 0x10 or 0x08 (2nd speed)
  doc["freezer_fan"]  = (m[16] & 0x60) != 0;   // 0x40 or 0x20 (2nd speed)
  doc["cooling_mode"] = coolMode(m[17]);
  doc["ice_bucket_full"] = (m[18] & 0x10) != 0;          // raw, as the fridge reports it
  doc["ice_bucket"]      = iceFull ? "Full" : "Not full";   // stabilised
  doc["defrost"]      = (m[17] & 0x80) != 0;
  doc["cooling_hold"] = (m[17] & 0x40) != 0;
  doc["ice_fills_24h"]   = iceFills24h();
  doc["ice_fills_total"] = iceFillTotal;
  doc["ice_cubes_24h"]   = iceFills24h() * ICE_CUBES_PER_FILL;
  doc["ice_cubes_total"] = iceFillTotal * ICE_CUBES_PER_FILL;   // all time (saved in flash)
  if (iceFillLastEp) doc["last_ice_fill"] = isoUtc(iceFillLastEp); else doc["last_ice_fill"] = nullptr;
  doc["uptime_s"]     = uptimeSec();
  doc["ip"]           = WiFi.localIP().toString();

  String payload;
  serializeJson(doc, payload);
  String stateTopic = String(mqtt_topic) + "/state";
  mqttClient.publish(stateTopic.c_str(), payload.c_str(), true);
  lastPubMs    = millis();
  lastPubB18   = m[18];
  lastPubB16   = m[16];
  lastPubB8    = m[8];
  lastPubB17   = m[17];
}

// Sends the undecoded bytes and bits to <prefix>/unknown (retained)
void publishUnknown() {
  if (!haveMsg || !mqttClient.connected()) return;
  const uint8_t* m = lastMsg;
  JsonDocument doc;
  for (uint8_t i : UNK_BYTES) { char k[8]; snprintf(k, sizeof k, "b%u", i); doc[k] = hx2(m[i]); }
  String b20;
  for (uint8_t i = UNK_FIRST; i <= UNK_LAST; i++) { char h[4]; snprintf(h, sizeof h, i > UNK_FIRST ? " %02X" : "%02X", m[i]); b20 += h; }
  doc["b20_28"] = b20;
  for (const UnkBit& u : UNK_BITS) { char k[12]; snprintf(k, sizeof k, "b%u_%02x", u.i, u.mask); doc[k] = (m[u.i] & u.mask) != 0; }
  doc["last_change"] = unkLastChange.length() ? unkLastChange : String("None since the monitor restarted");
  if (unkLastEp) doc["last_change_time"] = isoUtc(unkLastEp); else doc["last_change_time"] = nullptr;
  String payload;
  serializeJson(doc, payload);
  String topic = String(mqtt_topic) + "/unknown";
  mqttClient.publish(topic.c_str(), payload.c_str(), true);
  unkDirty = false;
}

// Sends one change record to <prefix>/change (retained)
void publishChange(const ChangeRec& c, uint32_t seq) {
  JsonDocument doc;
  doc["text"]    = c.txt;
  if (c.ep) doc["time"] = isoUtc(c.ep); else doc["time"] = nullptr;
  doc["seq"]     = seq;
  String payload;
  serializeJson(doc, payload);
  String topic = String(mqtt_topic) + "/change";
  mqttClient.publish(topic.c_str(), payload.c_str(), true);
}

// --------------------------------------------------------------------------------
// MQTT: HOME ASSISTANT AUTO-DISCOVERY
// --------------------------------------------------------------------------------
void discEntity(const char* comp, const char* key, const char* name, const char* tpl,
                const char* devClass, const char* icon, bool diagnostic, bool measurement,
                const char* unit, const char* topicSuffix = "/state", bool attrs = false) {
  String chipId = getChipIdHex();
  JsonDocument doc;
  doc["name"]               = name;
  doc["state_topic"]        = String(mqtt_topic) + topicSuffix;
  if (attrs) doc["json_attributes_topic"] = String(mqtt_topic) + topicSuffix;
  // Fridge entities need BOTH the board online AND fresh fridge data.
  // Board diagnostics (IP, uptime) only need the board online.
  bool boardOnly = (strcmp(key, "ip") == 0 || strcmp(key, "uptime") == 0);
  JsonArray av = doc["availability"].to<JsonArray>();
  av.add<JsonObject>()["topic"] = String(mqtt_topic) + "/availability";
  if (!boardOnly) {
    av.add<JsonObject>()["topic"] = String(mqtt_topic) + "/data_status";
    doc["availability_mode"] = "all";
  }
  doc["unique_id"]          = "fridge_" + chipId + "_" + key;
  doc["value_template"]     = tpl;
  if (devClass)    doc["device_class"]    = devClass;
  if (icon)        doc["icon"]            = icon;
  if (diagnostic)  doc["entity_category"] = "diagnostic";
  if (measurement) doc["state_class"]     = strstr(key, "_total") ? "total_increasing" : "measurement";
  if (unit) {
    doc["unit_of_measurement"] = unit;
    // whole degrees, except the calibrated sensor temperatures (one decimal place)
    doc["suggested_display_precision"] = (strstr(key, "_air_") || strstr(key, "_est_")) ? 1 : 0;
  }

  JsonObject dev = doc["device"].to<JsonObject>();
  dev["identifiers"][0] = "esp32_fridge_" + chipId;
  dev["name"]           = "Fridge Serial Monitor";
  dev["model"]          = "ESP32 Serial Sniffer";
  dev["manufacturer"]   = "Custom DIY";
  dev["sw_version"]     = FW_VERSION;

  String discTopic = String("homeassistant/") + comp + "/fridge_" + chipId + "_" + key + "/config";
  String payload;
  serializeJson(doc, payload);
  mqttClient.publish(discTopic.c_str(), payload.c_str(), true);
}

// Removes an entity left over from the earlier test versions (empty retained message)
void discRemove(const char* comp, const char* key) {
  String discTopic = String("homeassistant/") + comp + "/fridge_" + getChipIdHex() + "_" + key + "/config";
  mqttClient.publish(discTopic.c_str(), "", true);
}

