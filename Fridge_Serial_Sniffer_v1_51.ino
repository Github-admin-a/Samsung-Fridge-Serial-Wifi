function syncCtl(d){
  const s=$('baud');
  if(![...s.options].some(o=>+o.value===d.baud))s.add(new Option(d.baud+' (custom)',d.baud));
  s.value=d.baud;$('cbaud').value='';$('fmt').value=d.fmt;$('inv').checked=!!d.inv;$('gap').value=d.gap;
}
function clearView(){$('rows').innerHTML='';prev={};lastT=null;lines=[];}
function addFrame(f){
  const n=f.h.length/2,p=prev[n],hl=$('hl').checked;let hex='',plain='',asc='';
  for(let i=0;i<n;i++){
    const hh=f.h.substr(i*2,2),v=parseInt(hh,16);
    hex+=((hl&&p&&p.substr(i*2,2)!==hh)?'<b>'+hh+'</b>':hh)+' ';
    plain+=hh+' ';
    asc+=(v>=32&&v<127)?String.fromCharCode(v):'.';
  }
  prev[n]=f.h;
  const dl=lastT===null?'':String(f.t-lastT);lastT=f.t;
  const ts=(f.t/1000).toFixed(3);
  const tr=document.createElement('tr');
  [['t',ts],['d',dl],['n',n]].forEach(c=>{const td=document.createElement('td');td.className=c[0];td.textContent=c[1];tr.appendChild(td);});
  const th=document.createElement('td');th.innerHTML=hex;tr.appendChild(th);
  const ta=document.createElement('td');ta.className='a';ta.textContent=asc;tr.appendChild(ta);
  const rows=$('rows');rows.appendChild(tr);
  while(rows.children.length>1000)rows.removeChild(rows.firstChild);
  lines.push(ts+'\t'+dl+'\t'+n+'\t'+plain.trim()+'\t'+asc);
}
async function poll(){
  if(busy)return;busy=true;
  try{
    const ac=new AbortController();const to=setTimeout(()=>ac.abort(),4000);
    const r=await fetch('/data.json'+(PG==='Diag'?'?since='+since:''),{signal:ac.signal});clearTimeout(to);if(!r.ok)return;
    const d=await r.json();lastOk=Date.now();
    $('ver').textContent='v'+d.ver;
    if(PG==='Main'){showDec(d);showChg(d);}
    else if(PG==='Diag'){
      if(d.last<since){since=0;epoch=-1;clearView();return;}
      if(d.epoch!==epoch){epoch=d.epoch;clearView();}
      showDec(d);showLink(d);showKa(d);showUnk(d);
      if(!paused){d.frames.forEach(f=>{if(f.s>since){addFrame(f);since=f.s;}});since=d.last;
        if(d.frames.length&&$('auto').checked){const l=$('log');l.scrollTop=l.scrollHeight;}}
    }
    else if(PG==='Serial'){if(epoch!==d.epoch){epoch=d.epoch;syncCtl(d);}showKa(d);}
    else if(PG==='Wifi')showWifi(d);
    else if(PG==='Cal')showCal(d);
  }catch(e){}
  finally{busy=false;}
}
function post(u,b){return fetch(u,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:b||''});}
function applySet(){
  const cb=parseInt($('cbaud').value,10);const b=cb>0?cb:$('baud').value;
  post('/set','baud='+b+'&fmt='+$('fmt').value+'&inv='+($('inv').checked?1:0)+'&gap='+$('gap').value).then(()=>{epoch=-1;poll();});
}
function saveKa(){post('/keepalive','en='+($('kEn').checked?1:0)+'&sec='+encodeURIComponent($('kSec').value)).then(()=>{kaInit=false;poll();});}
function saveMqtt(){
  const e=encodeURIComponent;
  post('/save-mqtt','host='+e($('mh').value)+'&port='+e($('mp').value)+'&user='+e($('mu').value)+'&pass='+e($('mw').value)+'&topic='+e($('mt').value)+'&stale='+e($('ms').value))
    .then(()=>{mqInit=false;poll();});
}
function nudge(id,v){const e=$(id);e.value=(Math.round(((parseFloat(e.value)||0)+v)*10)/10).toString();}
function saveIce(){const m=parseFloat($('iFs').value);if(isNaN(m)||m<0||m>30){alert('0 to 30 minutes');return;}post('/ice-cfg','sec='+Math.round(m*60)).then(()=>{iceInit=false;poll();});}
function saveCal(){post('/cal','of='+encodeURIComponent($('oF').value)+'&oz='+encodeURIComponent($('oZ').value)).then(r=>{if(!r.ok)alert('Values must be between -5 and +5');calInit=false;poll();});}
async function wifiScan(start){
  const sel=$('wSel');
  if(start!==false){sel.innerHTML='';sel.add(new Option('Scanning...',''));}
  try{
    const r=await fetch('/wifi-scan.json'+(start!==false?'?start=1':''));const d=await r.json();
    if(d.scanning){clearTimeout(scanTimer);scanTimer=setTimeout(()=>wifiScan(false),1000);return;}
    sel.innerHTML='';
    d.nets.sort((a,b)=>b.r-a.r);
    if(!d.nets.length)sel.add(new Option('No networks found',''));
    d.nets.forEach(n=>{const o=new Option(n.s+'  ('+n.r+' dBm, '+(n.o?'open':'secured')+')'+(n.s===curSsid?'  - current':''),n.s);if(n.s===curSsid)o.selected=true;sel.add(o);});
  }catch(e){clearTimeout(scanTimer);scanTimer=setTimeout(()=>wifiScan(false),2000);}
}
function clearLog(){post('/clear').then(poll);}
function togglePause(){paused=!paused;$('pauseBtn').textContent=paused?'Resume':'Pause';}
