function showLink(d){
  const l=d.ln;let w='';
  if(l.e>=0&&l.e<15000&&(l.b<0||l.b>l.e+15000))w="<br><span class='bad'>The fridge signal is reaching the pin but the serial port is not receiving it.</span>";
  else if(l.e<0&&!l.lv)w="<br><span class='bad'>No signal seen and the line is LOW: check the signal wire, the ground wire and the level converter.</span>";
  $('lineStat').innerHTML='Signal on the pin: last activity '+ago(l.e)+' (line now '+(l.lv?'HIGH':'LOW')+') &nbsp;|&nbsp; Last byte received: '+ago(l.b)+
    ' &nbsp;|&nbsp; Automatic serial port recoveries: '+l.fix+'<br>Last reset: '+d.rr+w;
  let e='';
  if(d.fe||d.pe||d.ovf)e=" &nbsp;|&nbsp; <span class='bad'>Framing errors: "+d.fe+" &nbsp; Parity errors: "+d.pe+(d.ovf?" &nbsp; Overflows: "+d.ovf+" (port restarts: "+d.rst+")":"")+"</span>";
  else e=' &nbsp;|&nbsp; Framing/parity errors: 0';
  $('stat').innerHTML='<b>'+d.baud+' baud, '+FMTS[d.fmt]+(d.inv?', inverted':'')+'</b> &nbsp;|&nbsp; Bytes received: '+d.bytes+e+
    '<br>RX pin: GPIO '+d.pin+' &nbsp;|&nbsp; Wi-Fi: '+d.rssi+' dBm &nbsp;|&nbsp; Uptime: '+fmtUp(d.up)+' &nbsp;|&nbsp; Bad checksums: '+d.dec.bad;
}
function showCal(d){
  if(!iceInit&&d.ice){$('iFs').value=Math.round(d.ice.fs/30)/2;iceInit=true;}
  if(!calInit&&d.cal){$('oF').value=d.cal.of;$('oZ').value=d.cal.oz;calInit=true;}
  $('cAir').textContent=deg1(d.dec.air);
  $('cFzv').textContent=deg1(d.dec.fz);
