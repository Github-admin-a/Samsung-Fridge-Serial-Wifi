  $('wInfo').innerHTML='Network: <b></b> &nbsp;|&nbsp; IP: '+d.ip+' &nbsp;|&nbsp; Signal: '+d.rssi+' dBm';$('wInfo').querySelector('b').textContent=d.ssid;curSsid=d.ssid;
  $('mStat').innerHTML='MQTT status: '+(d.mq.host?(d.mq.on?'Connected':"<span class='bad'>Disconnected</span>"):'not configured');
