// --------------------------------------------------------------------------------
// MQTT: CONNECT / RECONNECT (LWT SETUP)
// --------------------------------------------------------------------------------
void reconnectMQTT() {
  if (strlen(mqtt_server) == 0) return;

  String clientId   = "ESP32Fridge-" + getChipIdHex();
  String availTopic = String(mqtt_topic) + "/availability";

  mqttClient.setBufferSize(2048);   // discovery payloads exceed the 256 byte default

  bool ok;
  if (strlen(mqtt_user) > 0) {
    ok = mqttClient.connect(clientId.c_str(), mqtt_user, mqtt_pass, availTopic.c_str(), 1, true, "offline");
  } else {
    ok = mqttClient.connect(clientId.c_str(), nullptr, nullptr, availTopic.c_str(), 1, true, "offline");
  }

  if (ok) {
    Serial.println(F("MQTT connected."));
    publishHomeAssistantDiscovery();
    // The fridge only talks when something changes, so send what we already
    // know straight away, then mark the device online.
    publishState();
    mqttDirty = false;
    publishUnknown();
    publishDataStatus();
    mqttClient.publish(availTopic.c_str(), "online", true);
  } else {
    Serial.printf("MQTT connect failed, state %d\n", mqttClient.state());
  }
}

